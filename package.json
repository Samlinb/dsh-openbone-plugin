{
  "name": "dsh-openbone-plugin",
  "version": "0.4.1",
  "description": "Create, edit and preview OpenBone skeletal animations through DSH.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samlinb/dsh-openbone-plugin.git"
  },
  "homepage": "https://github.com/Samlinb/dsh-openbone-plugin#readme",
  "bugs": {
    "url": "https://github.com/Samlinb/dsh-openbone-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "openbone",
    "animation",
    "mcp"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./server": "./src/server-plugin.js",
    "./runtime": {
      "types": "./vendor/web-runtime/src/index.d.ts",
      "default": "./vendor/web-runtime/src/index.js"
    },
    "./runtime/official": "./vendor/web-runtime/official/adapter.js",
    "./runtime/manifest": "./vendor/web-runtime/BUNDLE.json",
    "./package.json": "./package.json",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src/",
    "public/",
    "vendor/web-runtime/",
    "locale/",
    "cordis.patch.yml",
    "examples/server.json",
    "tools/serve.mjs",
    "tools/hosted.mjs",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.3 <0.2.2 || >=0.2.2-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/library.test.js test/runtime.test.js test/server.test.js test/release.test.js test/hosted.test.js test/trial.test.js test/setup.test.js",
    "test:hosted": "node --test test/hosted.test.js",
    "hosted": "node tools/hosted.mjs",
    "test:dsh": "node --test test/plugin.test.js",
    "test:dsh:version": "node tools/test-dsh-version.mjs",
    "check": "node tools/check.mjs",
    "release": "node tools/release.mjs",
    "publish:release": "node tools/release.mjs --publish",
    "release:dry": "node tools/release.mjs --dry-run --skip-gates --allow-dirty",
    "pack:release": "node tools/pack-release.mjs",
    "bundle:runtime": "node tools/bundle-runtime.mjs",
    "prepack": "node tools/check.mjs",
    "import:library": "node tools/import-library.mjs",
    "serve": "node tools/serve.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
