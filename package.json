{
  "name": "dsh-openbone-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "Create, edit and preview OpenBone skeletal animations through DSH.",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./server": "./src/server-plugin.js",
    "./runtime": {
      "types": "./vendor/web-runtime/src/index.d.ts",
      "default": "./vendor/web-runtime/src/index.js"
    },
    "./runtime/official": "./vendor/web-runtime/official/adapter.js",
    "./runtime/manifest": "./vendor/web-runtime/BUNDLE.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "public/",
    "vendor/web-runtime/",
    "locale/",
    "cordis.patch.yml",
    "examples/server.json",
    "tools/serve.mjs",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node tools/check.mjs",
    "bundle:runtime": "node tools/bundle-runtime.mjs",
    "prepack": "node tools/check.mjs",
    "import:library": "node tools/import-library.mjs",
    "serve": "node tools/serve.mjs"
  }
}
